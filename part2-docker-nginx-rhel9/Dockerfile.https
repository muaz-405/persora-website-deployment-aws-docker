# NOTE: rebuilt for this repository from the project steps (the original file was not kept).
# Stage 2 image "persora-secure": serves the site over HTTPS with a self-signed certificate.
# Build from the repository root:
#   docker build -f part2-docker-nginx-rhel9/Dockerfile.https -t persora-secure .
FROM nginx:alpine

RUN rm -rf /usr/share/nginx/html/*
COPY website/ /usr/share/nginx/html/

# Nginx site config with HTTPS + HTTP->HTTPS redirect
COPY part2-docker-nginx-rhel9/nginx/default.conf /etc/nginx/conf.d/default.conf

# Self-signed certificate generated on the host with OpenSSL (see commands.md)
# The ssl/ folder is in .gitignore - certificates and keys are never committed.
COPY part2-docker-nginx-rhel9/ssl/ /etc/nginx/ssl/

EXPOSE 80 443
